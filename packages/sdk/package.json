{
  "name": "@cared/sdk",
  "version": "0.1.13",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && prettier --check --write ./dist/_tsup*",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "prepublishOnly": "tsx ./scripts/prepare-publish.ts",
    "postpublish": "mv package.json.bak package.json",
    "test-client": "env NODE_TLS_REJECT_UNAUTHORIZED=0 tsx ./scripts/test-client.ts"
  },
  "devDependencies": {
    "@cared/api": "workspace:*",
    "@cared/auth": "workspace:*",
    "@cared/db": "workspace:*",
    "@cared/eslint-config": "workspace:*",
    "@cared/prettier-config": "workspace:*",
    "@cared/providers": "workspace:*",
    "@cared/shared": "workspace:*",
    "@cared/tools": "workspace:*",
    "@cared/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@cared/prettier-config",
  "peerDependencies": {
    "@ai-sdk/provider": ">=2.0.0",
    "@langfuse/core": ">=4.1.0",
    "@orpc/client": ">=1.10.4",
    "@orpc/server": ">=1.10.4",
    "@orpc/tanstack-query": ">=1.10.4",
    "@tanstack/react-query": ">=5.90.7",
    "ai": ">=5.0.38",
    "better-auth": ">=1.3.27",
    "buffer": ">=6.0.3",
    "drizzle-orm": ">=0.44.7",
    "react": ">=19.0.0",
    "stripe": ">=18.3.0",
    "superjson": ">=2.2.2",
    "zod": ">=4.1.12"
  }
}
