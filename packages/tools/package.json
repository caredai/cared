{
  "name": "@cared/tools",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./artifact": {
      "types": "./dist/artifact/index.d.ts",
      "default": "./src/artifact/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@cared/eslint-config": "workspace:*",
    "@cared/prettier-config": "workspace:*",
    "@cared/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@cared/prettier-config",
  "dependencies": {
    "@cared/db": "workspace:*",
    "@cared/providers": "workspace:*",
    "@cared/shared": "workspace:*",
    "@cared/vdb": "workspace:*",
    "@composio/core": "^0.6.3",
    "@composio/json-schema-to-zod": "^0.1.20",
    "@composio/vercel": "^0.6.3",
    "ai": "catalog:"
  }
}
