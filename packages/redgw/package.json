{
  "name": "@cared/redgw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/exports.d.ts",
      "default": "./src/exports.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts --server",
    "dev:server": "tsx watch src/index.ts --server",
    "dev:offloader": "tsx watch src/index.ts --offloader",
    "start": "node dist/index.js --server",
    "start:server": "node dist/index.js --server",
    "start:offloader": "node dist/index.js --offloader",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@cared/eslint-config": "workspace:*",
    "@cared/prettier-config": "workspace:*",
    "@cared/tsconfig": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "^5.9.2"
  },
  "prettier": "@cared/prettier-config",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@hono/node-server": "^1.19.6",
    "@js-temporal/polyfill": "^0.5.1",
    "@orpc/server": "^1.13.5",
    "@t3-oss/env-core": "^0.13.8",
    "falkordb": "github:caredai/falkordb-ts#main",
    "hono": "^4.11.1",
    "redis": "^5.10.0",
    "sanitize-filename": "^1.6.3",
    "zod": "4.1.12"
  }
}
