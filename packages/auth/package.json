{
  "name": "@cared/auth",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./server": "./src/server.tsx",
    "./client": "./src/client.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "generate-schema": "pnpm with-env pnpm dlx auth@latest generate -y --config ./src/server.tsx --output ../db/src/generated/auth.ts && pnpm prettier --check --write ../db/src/generated/auth.ts"
  },
  "devDependencies": {
    "@cared/eslint-config": "workspace:*",
    "@cared/prettier-config": "workspace:*",
    "@cared/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  },
  "prettier": "@cared/prettier-config",
  "dependencies": {
    "@better-auth/api-key": "1.6.11",
    "@better-auth/oauth-provider": "1.6.11",
    "@better-auth/passkey": "1.6.11",
    "@better-auth/utils": "0.4.0",
    "@cared/db": "workspace:*",
    "@cared/email": "workspace:*",
    "@cared/kv": "workspace:*",
    "@cared/log": "workspace:*",
    "@cared/shared": "workspace:*",
    "@permify/permify-node": "^1.1.4",
    "better-auth": "1.6.11",
    "better-auth-harmony": "1.3.2",
    "validation-better-auth": "^1.3.4",
    "viem": "^2.33.2"
  }
}
