# Non-sensitive configuration (loaded into drizzgw-config ConfigMap).
CARED_API_URL=https://api.cared.dev
CORS_ALLOWED_ORIGINS=https://cared.dev,http://localhost:3000
DOMAIN_SUFFIX=drizzgw.cared.dev
DRIZZLE_GATEWAY_IMAGE=caredai/drizzle-gateway:1.2.0
REDIS_CLUSTER_HEADLESS_SERVICE_HOSTNAME=redis-cluster-headless
K8S_NAMESPACE=cared
PORT=3000
MAX_IDLE_MINUTES=5
NEAR_IDLE_BUFFER_SECONDS=20
NODE_ENV=production
