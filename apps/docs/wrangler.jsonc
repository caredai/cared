{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cared-docs",
  "compatibility_date": "2025-09-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "nodejs_compat_populate_process_env"
  ],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "keep_names": false,
  "keep_vars": true,
  "send_metrics": false,
  "vars": {
  },
  "env": {
    "production": {
      "vars": {
      }
    }
  }
}
