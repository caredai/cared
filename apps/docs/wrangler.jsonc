{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cared-docs",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "keep_names": false,
  "keep_vars": true,
  "send_metrics": false,
  "vars": {},
  "env": {
    "production": {
      "vars": {}
    }
  }
}
