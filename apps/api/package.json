{
  "name": "cared-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "env NODE_ENV=development pnpm with-env tsx watch src/index.ts",
    "dev:https": "pnpm dev --https-key-path ~/.vite-plugin-mkcert/dev.pem --https-cert-path ~/.vite-plugin-mkcert/cert.pem",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@cared/api": "workspace:*",
    "@cared/auth": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@xmldom/xmldom": "^0.8.11",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cared/eslint-config": "workspace:*",
    "@cared/tsconfig": "workspace:*"
  }
}
