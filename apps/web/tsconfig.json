{
  "extends": "@cared/tsconfig/base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/public/*": [
        "./public/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "module": "esnext"
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
